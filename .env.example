# Postgres connection used by Prisma
DATABASE_URL="postgresql://routewise:routewise@localhost:5432/routewise?schema=public"

# Shared secret used to sign outbound webhooks and verify inbound ones (HMAC-SHA256)
ROUTEWISE_WEBHOOK_SECRET="whsec_replace_me"

# Public site URL, used for canonical links and Open Graph metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
